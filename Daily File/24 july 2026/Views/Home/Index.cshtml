@model _24_JULY_2026.Models.Student
<div class="text-center">
    <h3 class="display-4">Student Login</h3>
</div>

<form asp-action="Index" method="post">
  

    <br/>

    <div>
        <label asp-for="UserName"></label><br />
        <input asp-for="UserName" class="form-control" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>

    <br/>

    <div>
        <label asp-for="Passward"></label><br />
        <input asp-for="Passward" class="form-control" />
        <span asp-validation-for="Passward" class="text-danger"></span>
    </div>

    <br/>
    <button type="submit" class="btn btn-primary">Login</button>
</form>

<br/>

<span style="color:red">@ViewBag.Error</span>