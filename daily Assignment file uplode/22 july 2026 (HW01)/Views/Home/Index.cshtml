@model _22_JULY_2026__HW01_.Models.Automobile

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
</div>
<form asp-controller="Home" asp-action="Index" method="post">

    <div>
        <label asp-for="VehicleName"></label>
        <input asp-for="VehicleName" class="form-control" />
        <span asp-validation-for="VehicleName" style="colour : red"></span>
    </div>
    <br />

    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" style="colour : red"></span>
    </div>
    <br />

    <div>
        <label asp-for="Brand"></label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" style="colour : red"></span>
    </div>
    <br />

    <div>
        <label asp-for="ModelYear"></label>
        <input asp-for="ModelYear" class="form-control" />
        <span asp-validation-for="ModelYear" style="colour : red"></span>
    </div>
    <br />

    <div>
        <label asp-for="FuelType"></label>
        <input asp-for="FuelType" class="form-control"/>
        <span asp-validation-for="FuelType" style="colour: red"></span>
        </span>
    </div>

    <button type="submit"> Save Product</button>

</form>

<div asp-validation-summary="All"></div>
